#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="${GOBIN:-${ROOT}/.bin}"
GO_CACHE_DIR="${GOCACHE:-${ROOT}/.cache/go-build}"
LINT_BIN="${BIN_DIR}/golangci-lint"

# golangci-lint v2. .golangci.yml declares version: "2" and uses the v2
# `formatters:` block, so a v1 binary refuses the config outright. The module
# path carries the major version in v2.
MODULE="github.com/golangci/golangci-lint/v2/cmd/golangci-lint"
VERSION="${GOLANGCI_LINT_VERSION:-v2.13.2}"

# GOTMPDIR must NOT live in the repo. t.TempDir() derives from it, so a
# repo-local value puts test scratch directories inside the working tree and any
# test that walks up looking for .git finds graphkeeper itself. Same reason as
# scripts/test.
if [ -n "${GOTMPDIR:-}" ]; then
	GO_TMP_DIR="${GOTMPDIR}"
else
	GO_TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/graphkeeper-gotmp-XXXXXX")"
	trap 'rm -rf "${GO_TMP_DIR}"' EXIT
fi

mkdir -p "${BIN_DIR}" "${GO_CACHE_DIR}"

# No shim fallback. A previous version wrote a bash stub running only
# `gofmt -l` + `go vet` whenever `go install` failed, and scripts/lint then
# reported success while golangci-lint never ran at all. That stub sat in .bin
# from 2026-07-06 to 2026-08-28 and hid the v1/v2 config break for seven weeks.
# A lint gate that cannot lint must fail, not pass quietly.
if [[ ! -x "${LINT_BIN}" ]]; then
	echo "installing golangci-lint ${VERSION} into ${BIN_DIR}" >&2
	if ! GOBIN="${BIN_DIR}" GOCACHE="${GO_CACHE_DIR}" GOTMPDIR="${GO_TMP_DIR}" \
		go install "${MODULE}@${VERSION}"; then
		echo "" >&2
		echo "ERROR: could not install golangci-lint ${VERSION}." >&2
		echo "The lint gate cannot run, so this is a hard failure rather than a pass." >&2
		echo "Network access is required for the first run. To pin another version:" >&2
		echo "  GOLANGCI_LINT_VERSION=vX.Y.Z ./scripts/bootstrap" >&2
		exit 1
	fi
fi

cd "${ROOT}"
GOCACHE="${GO_CACHE_DIR}" GOTMPDIR="${GO_TMP_DIR}" go mod download >/dev/null 2>&1 || true
